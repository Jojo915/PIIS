{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2022",
    "outDir": "../out-test",
    "rootDir": "..",
    "lib": ["ES2022", "DOM"],
    "sourceMap": true,
    "strict": true,
    "types": ["node", "mocha"],
    "moduleResolution": "Node10",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["../src/**/*.ts", "./**/*.ts"],
  "exclude": ["../node_modules", "../.vscode-test", "../out", "../out-test"]
}
